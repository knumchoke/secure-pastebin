# Copy to deploy/.env. Never commit .env.
APP_BASE_URL=https://pastebin.internal.example
LISTEN_ADDR=:8443
# TLS_CERT_FILE=/run/secrets/tls_cert
# TLS_KEY_FILE=/run/secrets/tls_key
# TRUSTED_PROXY_CIDRS=10.0.0.0/8   # set when a reverse proxy terminates TLS

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

AUTH_MODE=local
# OIDC_ISSUER=https://keycloak.internal.example/realms/corp
# OIDC_CLIENT_ID=pastebin
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
# OIDC_REQUIRED_GROUP=pastebin-user
# OIDC_ADMIN_GROUP=pastebin-admin

CHALLENGE_ENABLED=true
VIEW_REQUIRES_AUTH=false
PASTE_MAX_SIZE=256KB
PASTE_TTL_DEFAULT=300
PASTE_TTL_MIN=30
PASTE_TTL_MAX=900
METADATA_RETENTION_DAYS=180
AUDIT_RETENTION_DAYS=365
REDIS_EXPECTED_USERS=50
LOG_LEVEL=info
